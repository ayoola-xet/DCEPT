{
  "name": "@dcept/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "generate:probes": "node ../../scripts/generate-web-probes.mjs",
    "predev": "npm run generate:probes",
    "dev": "next dev",
    "prebuild": "npm run generate:probes",
    "build": "next build",
    "start": "next start",
    "test:security": "node --test lib/security.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:probes": "node ../../scripts/generate-web-probes.mjs --check",
    "verify:wasm-trace": "node scripts/verify-wasm-trace.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "dcept": "file:./lib/wasm",
    "jose": "6.2.12",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "siwe": "3.0.0",
    "workflow": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.29.0"
    },
    "@workflow/world-vercel": {
      "undici": "7.29.0"
    }
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
